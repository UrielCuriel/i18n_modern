{
  "name": "i18n_modern",
  "version": "2.0.1",
  "description": "library for add dynamic localization for node an browsers",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "tsc --declaration --emitDeclarationOnly --outDir ./dist && bun build ./src/index.ts --outdir ./dist --target browser",
    "test": "bun test",
    "bench": "bun run src/bench/evaluator.bench.ts",
    "bench:i18n": "bun run src/bench/i18n.bench.ts",
    "bench:all": "bun run bench && bun run bench:i18n",
    "prepublish": "bun run build && bun test",
    "publish": "bun publish",
    "release": "bunx standard-version",
    "release:fix": "bunx standard-version --release-as patch",
    "release:minor": "bunx standard-version --release-as minor",
    "release:major": "bunx standard-version --release-as major",
    "precommit": "bunx pretty-quick --staged",
    "prepare": "bunx husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "bun-types": "^1.3.1",
    "husky": "^7.0.1",
    "pretty-quick": "^3.1.1",
    "standard-version": "^9.3.1",
    "typescript": "^5.6.3",
    "mitata": "^1.0.34"
  }
}
